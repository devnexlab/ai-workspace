# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DBNAME=ai_ops
PG_USER=postgres
PG_PASSWORD=postgres
# 连接池大小（默认 min=2 max=20，一般够用）
# PG_POOL_MIN=2
# PG_POOL_MAX=20

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=3456
# 客户机/生产环境务必 false；本机开发可 true
FLASK_DEBUG=false
FLASK_THREADED=true

# 可选：覆盖本地目录（默认 backend/outputs、backend/uploads）
# OUTPUT_DIR=
# UPLOAD_DIR=
